  "universes": {
    "U1": {
      "name": "Revenue Universe",
      "mission": "Create and capture demand: customer interaction, marketing, sales and market presence."
    },
    "U2": {
      "name": "Delivery Universe",
      "mission": "Build and deliver: operations, logistics, product development and quality."
    },
    "U3": {
      "name": "Capital & Compliance Universe",
      "mission": "Protect money and legitimacy: accounting, finance, tax, legal and regulatory control. Owns the Investment Automaton's rules."
    },
    "U4": {
      "name": "People Universe",
      "mission": "Hire, develop and retain people; culture and workplace health."
    },
    "U5": {
      "name": "Infrastructure Universe",
      "mission": "Technology, data, security and resilience of every system the enterprise runs on."
    },
    "U6": {
      "name": "Strategy Universe",
      "mission": "Direction, intelligence, scenarios and long-horizon bets."
    },
    "U7": {
      "name": "Continuity Universe",
      "mission": "Administration, knowledge, communication and crisis continuity."
    }
  },
