# Copy to .env and edit. NEVER commit .env — it is gitignored.
# Until DRY_RUN=false, every module SIMULATES: no transfer, no order.
DRY_RUN=true

# IBKR TWS/Gateway API endpoint (paper: 7497 TWS / 4002 Gateway; live: 7496 / 4001)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
IBKR_ACCOUNT_TYPE=CASH

# Cashflow sweep & routing
SWEEP_PROFIT_SHARE=0.30
ALLOC_PILLAR_3A=0.40
ALLOC_IBKR=0.60
PILLAR_3A_ANNUAL_CAP_CHF=7258
PILLAR_3A_PAID_YTD_CHF=0
PILLAR_3A_PROVIDER_QR_REF=CH-CREDITOR-REFERENCE-PLACEHOLDER

# DCA target & order shaping
PRIMARY_TICKER=VWRL
LIMIT_MAX_OFFSET_BPS=25
MIN_ORDER_CHF=50

# Swiss private-investor guardrail (owned by Tax Advisor + Regulatory Compliance Officer)
MIN_HOLDING_DAYS=180
MAX_TURNOVER_RATIO=5.0
MAX_ORDERS_PER_MONTH=12

# Copy-trading envelope (disabled by default)
COPYTRADE_ENABLED=false
COPYTRADE_MAX_NOTIONAL_PER_RUN_CHF=2000
COPYTRADE_MAX_SINGLE_POSITION_PCT=0.20
